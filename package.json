{
  "name": "chaoxing-auto-sign",
  "version": "3.2.0",
  "description": "Chaoxing (学习通) Auto Check-in System v3",
  "main": "electron/main.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && node -e \"var fs=require('fs'),p=require('path');var s='src/sdk',d='build/sdk';fs.mkdirSync(d,{recursive:true});if(fs.existsSync(s))fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))\" && node embed-config.js",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "pack": "node build-sea.js"
  },
  "keywords": [
    "chaoxing",
    "checkin",
    "学习通",
    "签到"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "axios": "^1.7.0",
    "axios-cookiejar-support": "^5.0.0",
    "chalk": "4",
    "cheerio": "1.0.0-rc.12",
    "jpeg-js": "^0.4.4",
    "jsdom": "^24.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tough-cookie": "^4.1.3",
    "yaml": "^2.4.0"
  },
  "optionalDependencies": {
    "nodemailer": "^10.0.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jsdom": "^21.0.0",
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "@yao-pkg/pkg": "^6.22.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "productName": "学习通自动签到",
  "build": {
    "appId": "com.liixnglinb.chaoxing-checkin",
    "productName": "学习通自动签到",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "assets/app-icon.ico",
      "assets/app-icon.png",
      "!node_modules/sharp/**",
      "!node_modules/electron/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.txt",
      "!node_modules/**/*.map",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/.github/**",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/HISTORY*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "学习通自动签到-安装版-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "学习通自动签到",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "学习通自动签到-安装版-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "compression": "maximum"
  }
}
